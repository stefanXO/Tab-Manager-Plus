{
  "name": "tab-manager-plus",
  "version": "7.0.0",
  "description": "This is an extended version of the old Tab Manager Google Chrome extension. Should work on both Chrome and Firefox. Malware free, with a new view type and many new features.",
  "main": "index.js",
  "directories": {
    "src": "src"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "tsc --noEmit && node build.mjs",
    "build:dev": "tsc --noEmit && node build.mjs --dev",
    "watch": "tsc --noEmit && node build.mjs --watch",
    "watch:dev": "tsc --noEmit && node build.mjs --watch --dev",
    "build:firefox": "tsc --noEmit && node build.mjs --firefox",
    "build:firefox:dev": "tsc --noEmit && node build.mjs --firefox --dev",
    "watch:firefox:dev": "tsc --noEmit && node build.mjs --firefox --watch --dev",
    "version": "node scripts/sync-version.mjs && git add manifest.json manifest-firefox.json readme.md changelog.html",
    "check-version": "node scripts/sync-version.mjs --check",
    "release": "bash babelit.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanXO/Tab-Manager.git"
  },
  "author": "",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/stefanXO/Tab-Manager/issues"
  },
  "homepage": "https://github.com/stefanXO/Tab-Manager#readme",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.1",
    "crx3": "^1.1.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "browserslist": [
    "Chrome >= 88"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
