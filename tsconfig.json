{
	"compilerOptions": {
		"jsx": "react-jsx",
		"outDir": "ts-built",
		"rootDir": "src",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"@views": [
				"./src/popup/views/index"
			],
			"@background/*": [
				"./src/service_worker/background/*"
			],
			"@helpers/*": [
				"./src/helpers/*"
			],
			"@types": [
				"./src/types/index"
			],
			"@ui/*": [
				"./src/service_worker/ui/*"
			],
			"@strings": [
				"./src/strings/strings"
			],
			"@context": [
				"./src/service_worker/context"
			]
		},
		"target": "ES2020",
		"types": [
			"chrome"
		],
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"**/*.spec.ts"
	]
}